{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cno/current-date",
	"version": "1.0.0",
	"title": "Current Date",
	"category": "widgets",
	"icon": "calendar",
	"description": "A current date block.",
	"keywords": [ "current", "date", "time" ],
	"supports": {
		"html": false,
		"align": true,
		"className": true,
		"color": {
			"text": true,
			"background": false
		},
		"typography": {
			"fontSize": true
		}
	},
	"attributes": {
		"format": {
			"type": "string",
			"default": "Y"
		}
	},
	"editorScript": "file:./index.tsx",
	"render": "file:./render.php"
}
